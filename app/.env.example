# The public URL of your mock Blink backend server (e.g., ngrok or cloudflared tunnel)
VITE_ACTIONS_API_URL=http://localhost:3001

# Temporary devnet test token from spl-token-faucet.com
# The smart contract developer will provide the final shared constants (including token_mint) once the contract is ready; swap this value then.
VITE_TEST_TOKEN_MINT=Gh9ZwEmdLJ8DscKNTkTqPbNwLNNBjuSzaG9Vp2KGtKJr
VITE_TOKEN_SYMBOL=USDC-Dev
TELEGRAM_BOT_TOKEN=your_botfather_token_here

# Custom RPC endpoints. Leave empty to use public endpoints.
# Note: Public mainnet-beta endpoint blocks browser requests (403), so a custom URL (Helius/Quicknode) is required for mainnet.
VITE_SOLANA_RPC_URL_DEVNET=
VITE_SOLANA_RPC_URL_MAINNET=
